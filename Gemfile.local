# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "robot_lab", path: "../robot_lab"

group :development, :test do
  gem "flay"
  gem "flog"
  gem "irb"
  gem "rake", "~> 13.0"
  gem "rubocop"
end

group :test do
  gem "minitest", "~> 5.16"
  gem "minitest-reporters"
  gem "simplecov", require: false
end
